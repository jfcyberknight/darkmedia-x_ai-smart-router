# =============================================================================
# ai-smart-router — modèle des variables d'environnement
# -----------------------------------------------------------------------------
# Copier ce fichier en .env (sur le serveur, jamais committé) et remplir.
#   cp .env.example .env
# Sur le VPS : ce .env vit dans /home/ubuntu/apps/ai-smart-router/.env
# =============================================================================

# --- AUTH (OBLIGATOIRE) ------------------------------------------------------
# Secret partagé qui protège les endpoints (/api/chat, /api/normalize, /api/tts).
# Tes apps l'envoient via l'en-tête :
#   Authorization: Bearer <AI_SMART_ROUTER_HEADER_KEY>   (ou X-API-Key: <...>)
# Minimum 8 caractères. En générer un : openssl rand -hex 32
AI_SMART_ROUTER_HEADER_KEY=

# --- PROVIDERS IA (AU MOINS UN REQUIS) ---------------------------------------
# Le router tire un provider au hasard à chaque requête (répartition du quota)
# et bascule sur le suivant en cas d'échec. Seuls les providers dont la clé est
# définie ci-dessous sont actifs.

# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# NVIDIA NIM — https://build.nvidia.com
NVAPI_API_KEY=

# DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Mistral — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# OpenCode Go (subscription) — endpoint dédié aux abonnés Go
# (https://opencode.ai/zen/go/v1). Clé distincte de l'endpoint prépayé Zen.
OPENCODE_GO_API_KEY=

# Ollama (optionnel) — cloud (clé) ou local (OLLAMA_HOST=http://localhost:11434)
OLLAMA_API_KEY=
OLLAMA_HOST=

# --- TTS (OPTIONNEL — active /api/tts si au moins une clé est présente) -------
ELEVENLABS_API_KEY=
TOGETHER_API_KEY=
TTS_API_KEY=
TTS_API_URL=

# --- AUTH HMAC CLIENT/SERVEUR (OPTIONNEL, avancé) ----------------------------
# Alternative à la clé partagée : signature HMAC (X-Client-Key + X-Signature).
CLIENT_KEY_AI_SMART_ROUTER=
SERVER_SECRET_AI_SMART_ROUTER=

# --- CORS (OPTIONNEL — API privée) -------------------------------------------
# Par défaut, AUCUNE origine navigateur ne peut lire les réponses (usage
# serveur-à-serveur). Si un consommateur navigateur légitime existe, lister
# ici ses origines exactes, séparées par des virgules :
#   CORS_ORIGINS=https://app1.darkmedia-x.com,https://app2.darkmedia-x.com
# CORS_ORIGINS=

# --- SERVEUR (facultatif — défauts sains) ------------------------------------
# PORT interne au conteneur (défaut 8080). HOST interne (défaut 0.0.0.0).
# PORT=8080
# HOST=0.0.0.0

# --- PERFORMANCE (facultatif — défauts sains) --------------------------------
# Provider testé en premier (défaut openrouter). Pour réduire la variabilité de
# latence, cibler un provider direct plus rapide (ex. "groq").
# ROUTER_PREFERRED_PROVIDER=openrouter

# Délai max par appel provider en ms (défaut 25000). Au-delà, abort + fallback.
# PROVIDER_TIMEOUT_MS=25000

# Cache LRU des réponses de chat (texte uniquement, pas multimodal).
# CACHE_ENABLED=true            # "false" désactive complètement.
# CACHE_TTL_SECONDS=30          # durée de vie d'une entrée.
# CACHE_MAX_ENTRIES=256         # nombre max d'entrées (éviction LRU).

# Concurrence entrante max (défaut 64). Au-delà, 503 + Retry-After.
# MAX_CONCURRENT_REQUESTS=64
