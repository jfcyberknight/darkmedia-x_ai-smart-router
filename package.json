{
  "name": "darkmedia-x-ai-smart-router",
  "version": "2.1.0",
  "description": "API auto-hébergée qui route les requêtes IA vers Gemini, Groq, NVIDIA, DeepSeek, OpenRouter, Mistral, Ollama avec ordre aléatoire et fallback automatique",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "dev:vercel": "vercel dev",
    "deploy": "vercel --prod",
    "prepare": "node scripts/install-git-hooks.js",
    "env:push": "node scripts/vercel-env-push.js",
    "env:push:root": "node scripts/vercel-env-push.js .env",
    "env:sync": "node scripts/env-sync.js",
    "env:sync:force": "node scripts/env-sync.js --force",
    "test": "node --test tests/*.test.js",
    "test:providers": "node scripts/test-providers.js",
    "test:api": "node scripts/test-api.js",
    "test:api:prod": "node scripts/test-api-deployed.js",
    "bench": "node scripts/bench.js",
    "bench:wrk": "bash scripts/bench-wrk.sh"
  },
  "keywords": [
    "ai",
    "router",
    "gemini",
    "groq",
    "self-hosted",
    "api"
  ],
  "author": "Darkmedia-X",
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cookie": "^1.1.1",
    "express": "^4.21.2",
    "google-auth-library": "^10.6.2",
    "jsonwebtoken": "^9.0.3"
  }
}
